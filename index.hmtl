<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Simulador de Alerta Sísmica</title>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #f4f7fa;
        color: #17212b;
    }

    header {
        background: #173f5f;
        color: white;
        text-align: center;
        padding: 22px;
    }

    header h1 {
        margin: 0 0 7px;
        font-size: 2rem;
    }

    header p {
        margin: 0;
        opacity: 0.9;
    }

    main {
        max-width: 1150px;
        margin: auto;
        padding: 25px;
    }

    .intro {
        text-align: center;
        margin-bottom: 25px;
    }

    .simulator {
        display: grid;
        grid-template-columns: 1.4fr 0.8fr;
        gap: 20px;
    }

    .card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.10);
    }

    .diagram {
        overflow: hidden;
    }

    svg {
        width: 100%;
        height: auto;
        display: block;
    }

    .controls label {
        display: block;
        margin-top: 18px;
        font-weight: bold;
    }

    input[type="range"] {
        width: 100%;
        margin-top: 8px;
    }

    button {
        width: 100%;
        margin-top: 25px;
        padding: 13px;
        border: none;
        border-radius: 8px;
        background: #e67e22;
        color: white;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
    }

    button:hover {
        background: #cf6d17;
    }

    .results {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 15px;
        margin-top: 20px;
    }

    .result {
        background: white;
        border-radius: 10px;
        padding: 18px;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .result h3 {
        font-size: 0.95rem;
        margin-top: 0;
        color: #53616d;
    }

    .number {
        font-size: 1.8rem;
        font-weight: bold;
        color: #173f5f;
    }

    .explanation {
        margin-top: 25px;
    }

    .steps {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 15px;
    }

    .step {
        padding: 15px;
        border-left: 4px solid #e67e22;
        background: #f8fafc;
    }

    .formula {
        background: #edf3f7;
        border-radius: 8px;
        padding: 15px;
        margin-top: 15px;
        text-align: center;
        font-size: 1.1rem;
    }

    .note {
        font-size: 0.85rem;
        color: #66727c;
        margin-top: 20px;
    }

    footer {
        text-align: center;
        margin-top: 30px;
        padding: 20px;
        color: #65727e;
        font-size: 0.85rem;
    }

    @media(max-width:800px) {
        .simulator {
            grid-template-columns: 1fr;
        }

        .results,
        .steps {
            grid-template-columns: 1fr;
        }
    }
</style>
</head>

<body>

<header>
    <h1>🌎 Simulador de Alerta Sísmica</h1>
    <p>Distancia, propagación de ondas y tiempo de oportunidad</p>
</header>

<main>

<section class="intro">
    <h2>¿Por qué una alerta puede llegar antes que las ondas sísmicas?</h2>

    <p>
        La alerta sísmica no predice los sismos. Detecta un sismo que ya ocurrió
        y aprovecha que la información puede transmitirse más rápidamente
        que las ondas sísmicas.
    </p>
</section>

<section class="simulator">

<div class="card diagram">

<svg viewBox="0 0 760 360">

    <!-- cielo -->
    <rect x="0" y="0" width="760" height="240" fill="#eaf4fb"/>

    <!-- terreno -->
    <path d="
        M0 240
        Q100 200 180 235
        Q280 260 380 225
        Q480 200 570 235
        Q660 255 760 220
        L760 360
        L0 360 Z"
        fill="#c99b67"/>

    <!-- falla / hipocentro -->
    <circle cx="105" cy="285" r="9" fill="#d63031"/>

    <line x1="105" y1="285"
          x2="105" y2="235"
          stroke="#d63031"
          stroke-width="3"/>

    <text x="105" y="215"
          text-anchor="middle"
          font-size="18"
          font-weight="bold">
        Epicentro
    </text>

    <text x="105" y="320"
          text-anchor="middle"
          font-size="14">
        Hipocentro
    </text>

    <!-- sensor -->
    <g transform="translate(155 185)">
        <rect x="-15" y="25"
              width="30" height="30"
              fill="#34495e"/>

        <line x1="0" y1="25"
              x2="0" y2="0"
              stroke="#34495e"
              stroke-width="4"/>

        <path d="M-12 12 Q0 0 12 12"
              fill="none"
              stroke="#34495e"
              stroke-width="3"/>

        <path d="M-20 5 Q0 -15 20 5"
              fill="none"
              stroke="#34495e"
              stroke-width="3"/>

        <text x="0" y="75"
              text-anchor="middle"
              font-size="14">
            Sensor
        </text>
    </g>

    <!-- ciudad -->
    <g transform="translate(640 165)">
        <rect x="0" y="35"
              width="45" height="70"
              fill="#46637f"/>

        <rect x="50" y="15"
              width="50" height="90"
              fill="#36516a"/>

        <rect x="15" y="50"
              width="8" height="10"
              fill="white"/>

        <rect x="65" y="30"
              width="8" height="10"
              fill="white"/>

        <text x="50" y="135"
              text-anchor="middle"
              font-size="18"
              font-weight="bold">
            Ciudad
        </text>
    </g>

    <!-- trayectoria -->
    <line x1="120" y1="265"
          x2="650" y2="265"
          stroke="#777"
          stroke-width="2"
          stroke-dasharray="8 8"/>

    <!-- onda -->
    <g id="wave" transform="translate(120 265)">
        <circle cx="0" cy="0"
                r="15"
                fill="#e74c3c"/>

        <circle cx="0" cy="0"
                r="27"
                fill="none"
                stroke="#e74c3c"
                stroke-width="3"/>

        <text x="0" y="-38"
              text-anchor="middle"
              font-size="16"
              font-weight="bold"
              fill="#c0392b">
            Onda S
        </text>
    </g>

    <!-- alerta -->
    <path d="
        M165 160
        C300 70 500 70 650 160"
        fill="none"
        stroke="#2980b9"
        stroke-width="4"
        stroke-dasharray="9 7"/>

    <g id="signal" transform="translate(165 160)">
        <circle cx="0" cy="0"
                r="11"
                fill="#2980b9"/>

        <text x="0" y="-20"
              text-anchor="middle"
              font-size="16"
              font-weight="bold"
              fill="#21618c">
            Alerta
        </text>
    </g>

    <text id="distanceSVG"
          x="385"
          y="300"
          text-anchor="middle"
          font-size="17">
        300 km
    </text>

</svg>

</div>


<div class="card controls">

<h2>Parámetros</h2>

<label>
Distancia fuente–ciudad:
<span id="distanceValue">300</span> km
</label>

<input id="distance"
       type="range"
       min="50"
       max="600"
       step="10"
       value="300">


<label>
Velocidad de la onda S:
<span id="velocityValue">3.5</span> km/s
</label>

<input id="velocity"
       type="range"
       min="2.5"
       max="5"
       step="0.1"
       value="3.5">


<label>
Detección + procesamiento:
<span id="processingValue">8</span> s
</label>

<input id="processing"
       type="range"
       min="1"
       max="30"
       step="1"
       value="8">


<label>
Tiempo de comunicación:
<span id="communicationValue">2</span> s
</label>

<input id="communication"
       type="range"
       min="0"
       max="10"
       step="0.5"
       value="2">


<button id="simulate">
▶ Iniciar simulación
</button>

</div>

</section>


<section class="results">

<div class="result">

<h3>Llegada de la onda S</h3>

<div class="number" id="waveTime">
85.7 s
</div>

<p>t = R / V<sub>S</sub></p>

</div>


<div class="result">

<h3>Llegada de la alerta</h3>

<div class="number" id="alertTime">
10.0 s
</div>

<p>detección + comunicación</p>

</div>


<div class="result">

<h3>Tiempo de oportunidad</h3>

<div class="number" id="opportunity">
75.7 s
</div>

<p id="message">
La alerta llega antes que la onda S.
</p>

</div>

</section>


<section class="card explanation">

<h2>¿Qué está ocurriendo?</h2>

<div class="steps">

<div class="step">
<strong>1. Ocurre el sismo</strong>
<p>
Las ondas sísmicas comienzan a propagarse desde la fuente.
</p>
</div>

<div class="step">
<strong>2. El sismo es detectado</strong>
<p>
Sensores cercanos registran el movimiento y el sistema procesa
la información.
</p>
</div>

<div class="step">
<strong>3. Se transmite la alerta</strong>
<p>
La señal puede llegar a una ciudad distante antes que las
ondas sísmicas.
</p>
</div>

</div>

<div class="formula">

t<sub>S</sub> =
R / V<sub>S</sub>

&nbsp;&nbsp;&nbsp;

t<sub>alerta</sub> =
t<sub>detección</sub> + t<sub>comunicación</sub>

<br><br>

<strong>
Tiempo de oportunidad =
t<sub>S</sub> − t<sub>alerta</sub>
</strong>

</div>

<p class="note">
Este simulador es un modelo educativo simplificado.
Los sistemas reales de alerta sísmica consideran múltiples estaciones,
algoritmos de detección y estimación, características de la fuente,
trayectorias de propagación y otros factores.
</p>

</section>

<footer>

Herramienta educativa para la enseñanza de sismología

</footer>

</main>


<script>

const distance =
document.getElementById("distance");

const velocity =
document.getElementById("velocity");

const processing =
document.getElementById("processing");

const communication =
document.getElementById("communication");

const wave =
document.getElementById("wave");

const signal =
document.getElementById("signal");

const button =
document.getElementById("simulate");

let animation = null;


/* ------------------------
   CALCULAR TIEMPOS
------------------------- */

function calculate(){

    const R =
    Number(distance.value);

    const Vs =
    Number(velocity.value);

    const processingTime =
    Number(processing.value);

    const communicationTime =
    Number(communication.value);


    const waveArrival =
    R / Vs;

    const alertArrival =
    processingTime +
    communicationTime;

    const opportunity =
    waveArrival -
    alertArrival;


    document.getElementById(
    "distanceValue"
    ).textContent = R;


    document.getElementById(
    "velocityValue"
    ).textContent =
    Vs.toFixed(1);


    document.getElementById(
    "processingValue"
    ).textContent =
    processingTime;


    document.getElementById(
    "communicationValue"
    ).textContent =
    communicationTime;


    document.getElementById(
    "distanceSVG"
    ).textContent =
    R + " km";


    document.getElementById(
    "waveTime"
    ).textContent =
    waveArrival.toFixed(1) + " s";


    document.getElementById(
    "alertTime"
    ).textContent =
    alertArrival.toFixed(1) + " s";


    document.getElementById(
    "opportunity"
    ).textContent =
    opportunity.toFixed(1) + " s";


    const message =
    document.getElementById("message");


    if(opportunity > 0){

        message.textContent =
        "La alerta llega antes que la onda S.";

    }

    else if(opportunity === 0){

        message.textContent =
        "La alerta y la onda S llegan aproximadamente al mismo tiempo.";

    }

    else{

        message.textContent =
        "La onda S llegaría antes que la alerta.";

    }


    return {
        waveArrival,
        alertArrival
    };

}


/* ------------------------
   REINICIAR ANIMACIÓN
------------------------- */

function resetAnimation(){

    if(animation){

        cancelAnimationFrame(animation);

        animation = null;

    }

    wave.setAttribute(
    "transform",
    "translate(120 265)"
    );

    signal.setAttribute(
    "transform",
    "translate(165 160)"
    );

    button.textContent =
    "▶ Iniciar simulación";

}


/* ------------------------
   CONTROLES
------------------------- */

[
distance,
velocity,
processing,
communication
].forEach(control => {

    control.addEventListener(
    "input",
    () => {

        resetAnimation();
        calculate();

    });

});


/* ------------------------
   SIMULACIÓN
------------------------- */

button.addEventListener(
"click",
() => {

    if(animation){

        resetAnimation();
        return;

    }


    const times =
    calculate();


    const maxTime =
    Math.max(
        times.waveArrival,
        times.alertArrival
    );


    const animationDuration =
    6000;


    const start =
    performance.now();


    button.textContent =
    "⏸ Detener";


    function animate(now){

        const elapsed =
        ((now - start) /
        animationDuration) *
        maxTime;


        const waveProgress =
        Math.min(
            1,
            elapsed /
            times.waveArrival
        );


        const alertProgress =
        Math.min(
            1,
            elapsed /
            times.alertArrival
        );


        /* movimiento onda S */

        const waveX =
        120 +
        (530 * waveProgress);

        wave.setAttribute(
        "transform",
        `translate(${waveX} 265)`
        );


        /* movimiento señal alerta */

        const alertX =
        165 +
        (485 * alertProgress);

        /*
        trayectoria arqueada
        */

        const normalized =
        alertProgress;

        const alertY =
        160 -
        75 *
        Math.sin(
            Math.PI *
            normalized
        );


        signal.setAttribute(
        "transform",
        `translate(${alertX} ${alertY})`
        );


        if(elapsed < maxTime){

            animation =
            requestAnimationFrame(
            animate
            );

        }

        else{

            animation = null;

            button.textContent =
            "↻ Repetir simulación";

        }

    }


    animation =
    requestAnimationFrame(
    animate
    );

});


calculate();

</script>

</body>
</html>
